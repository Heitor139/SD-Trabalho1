import java.io.IOException;
import java.io.OutputStream;

public class CandidatoOutputStream extends OutputStream {
    private OutputStream destino = null;
    private Candidato[] candidatos = null;
    private int quantidade = 0;

    public CandidatoOutputStream(OutputStream destino, Candidato[] candidatos, int quantidade) {
        this.destino = destino;
        this.candidatos = candidatos;
        this.quantidade = quantidade;
    }

    @Override 
    public void write(int b) throws IOException {
        destino.write(b);
    }

    public void enviarCandidatos() throws IOException {
        for (int i = 0; i < quantidade; i++) {

            String dados = candidatos[i].getNome() + ", " + candidatos[i].getNumero() + "\n";
            byte[] bytes = dados.getBytes();
            destino.write(bytes);

        }
    }```
}